# Derived image for running the modern TimesTen samples.
#
# Build the persistent TimesTen base image first from the official Oracle
# Container Registry image, then pass its local name through BASE_IMAGE. The
# base image owns TimesTen installation and startup; this file only adds the
# language runtimes and drivers used by the samples.
#
ARG BASE_IMAGE=tt-modern-demos-base
FROM ${BASE_IMAGE}

ARG NPM_REGISTRY=https://registry.npmjs.org/

USER root

# The TimesTen 26 Java 25 image is based on Oracle Linux 9. The matching
# ttjdbc25.jar is supplied by TimesTen; the demo image adds only the runtime
# packages and Java compiler needed by the samples.
RUN dnf install -y --setopt=install_weak_deps=False \
      python3 python3-pip nodejs npm java-25-openjdk-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Install the database drivers outside the bind-mounted sample checkout. The
# Node.js runner sets NODE_PATH so the mounted samples can resolve oracledb.
RUN python3 -m pip install --no-cache-dir oracledb \
    && npm install --registry "${NPM_REGISTRY}" --omit=dev --prefix /opt/timesten-modern-demos oracledb

ENV NODE_PATH=/opt/timesten-modern-demos/node_modules

USER timesten
