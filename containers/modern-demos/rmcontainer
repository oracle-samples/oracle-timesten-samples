# Remove a stopped modern TimesTen demo container.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
source "${SCRIPT_DIR}/common"

if [[ $# -ne 0 ]]; then
  echo "Usage: ./rmcontainer" >&2
  exit 1
fi
if ! load_config; then
  exit 1
fi

if ! status=$(container_status); then
  echo "Container '${DEMO_CONTAINER}' does not exist."
  exit 0
fi
if [[ "${status}" == "running" ]]; then
  echo "Stop container '${DEMO_CONTAINER}' with ./ttstop before removing it." >&2
  exit 1
fi

"${CONTAINER_ENGINE}" rm "${DEMO_CONTAINER}" >/dev/null
echo "Container '${DEMO_CONTAINER}' removed."
