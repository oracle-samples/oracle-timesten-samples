set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
source "${SCRIPT_DIR}/common"

if ! load_config || ! require_running_container; then
  exit 1
fi

if [[ $# -eq 0 ]]; then
  exec "${CONTAINER_ENGINE}" exec --interactive --tty \
    --workdir /workspace \
    "${DEMO_CONTAINER}" /usr/local/bin/remenv /bin/bash -il
fi

exec "${CONTAINER_ENGINE}" exec \
  --workdir /workspace \
  "${DEMO_CONTAINER}" /usr/local/bin/remenv "$@"
