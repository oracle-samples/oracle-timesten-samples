# Remove the persistent volume used by the modern TimesTen demo container.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
source "${SCRIPT_DIR}/common"

if [[ $# -ne 0 ]]; then
  echo "Usage: ./rmvolume" >&2
  exit 1
fi
if ! load_config; then
  exit 1
fi
if "${CONTAINER_ENGINE}" container inspect "${DEMO_CONTAINER}" >/dev/null 2>&1; then
  echo "Remove container '${DEMO_CONTAINER}' with ./rmcontainer before removing its volume." >&2
  exit 1
fi

"${CONTAINER_ENGINE}" volume rm "${DEMO_VOLUME}" >/dev/null
echo "Volume '${DEMO_VOLUME}' removed."
