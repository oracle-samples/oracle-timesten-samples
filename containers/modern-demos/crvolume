# Create the persistent volume used by the modern TimesTen demo container.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
source "${SCRIPT_DIR}/common"

if [[ $# -ne 0 ]]; then
  echo "Usage: ./crvolume" >&2
  exit 1
fi
if ! load_config; then
  exit 1
fi

"${CONTAINER_ENGINE}" volume create "${DEMO_VOLUME}" >/dev/null
echo "Volume '${DEMO_VOLUME}' is ready."
